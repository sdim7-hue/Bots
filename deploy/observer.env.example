# /etc/observer.env  -- chmod 600, owner dsolovev. NOT committed: real secrets live only here.
# Channel auto-enables when its vars are set (console always on).

# --- Board read tokens (read-only) ---
GITHUB_TOKEN=__github_pat__          # reads Bots queue on GitHub (claude-desktop-mcp PAT)
FORGEJO_TOKEN=__forgejo_token__      # reads map/zvuk on local Forgejo (scope read:issue/repository)
# (forgejo api_base comes from observer/projects.json -> http://127.0.0.1:3000/api/v1)

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=__from_BotFather__
TELEGRAM_CHAT_ID=__your_numeric_chat_id__

# --- Email / SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
