[Unit]
Description=Observer collect+notify loop (read-only)
After=network-online.target forgejo.service
Wants=network-online.target

[Service]
Type=simple
User=dsolovev
WorkingDirectory=/opt/observer/src
EnvironmentFile=/etc/observer.env
ExecStart=/usr/bin/python3 -m observer run --interval 120
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
